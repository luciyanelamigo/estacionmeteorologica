# MySQL local (crear previamente la base de datos y usuario indicados en README.md)
DATABASE_URL=mysql+pymysql://weather:weather@127.0.0.1:3306/estacion_meteorologica?charset=utf8mb4

# Puerto donde está conectado el Arduino/ESP (Linux típico: /dev/ttyUSB0 o /dev/ttyACM0)
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD=9600

PORT=5000
HOST=127.0.0.1
FLASK_DEBUG=1
